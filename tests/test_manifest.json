        "event.dataset: \"windows.sysmon_operational\""
      ],
      "test_cases": [
        {
          "fixture": "positive_process_creation.json",
          "expected_match": true
        },
        {
          "fixture": "negative_process_creation.json",
          "expected_match": false
        }
      ]
    },
