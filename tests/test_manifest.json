{
  "detections": [
    {
      "name": "Scheduled Task Creation via Schtasks",
      "rule_file": "detections/scheduled_task_creation_via_schtasks.toml",
      "fixture_directory": "tests/fixtures/scheduled_task_creation_via_schtasks",
      "matcher": "scheduled_task_creation",
      "expected_rule_metadata": {
        "severity": "medium",
        "risk_score": 47,
        "index": ["logs-windows.sysmon_operational-*"],
        "mitre_id": "T1053.005"
      },
      "expected_query_fragments": [
        "event.category: process",
        "process.name: schtasks.exe",
        "process.command_line: *Create*",
        "event.dataset: \"windows.sysmon_operational\""
      ],
      "test_cases": [
        {
          "fixture": "positive_process_creation.json",
          "expected_match": true
        },
        {
          "fixture": "negative_process_creation.json",
          "expected_match": false
        }
      ]
    },
    {
